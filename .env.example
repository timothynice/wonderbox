# Keys are read by the Node server only. Never use a VITE_ prefix for secrets.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
# Optional Gemini fallback, tried once only when the primary model returns HTTP503.
# Defaults to gemini-2.5-flash; use an empty value to disable.
# AI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# OpenAI or an OpenAI-compatible provider:
# AI_PROVIDER=openai
# AI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1

# Local release defaults. Use access control before exposing a credentialed server.
HOST=127.0.0.1
PORT=3001
# ALLOWED_ORIGIN=https://your-authenticated-domain.example

# Required on Vercel: shared code protecting credentialed model calls only.
# Configure as a sensitive server environment variable, never commit a real value.
AI_ACCESS_CODE=

# Phone snapshots: Vercel automatically supplies this when linking a PRIVATE Blob store.
# BLOB_READ_WRITE_TOKEN=
# Conventional Node hosting: use a durable directory, never ephemeral serverless disk.
# SHARE_DIRECTORY=.wonderbox-shares
