{
  "name": "wonderbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test:critical": "npm run build && playwright test",
    "test:critical:headed": "npm run build && playwright test --headed",
    "check:dependencies": "tsx scripts/check-dependencies.ts"
  },
  "dependencies": {
    "@agent-native/core": "0.222.2",
    "@vercel/blob": "^2.8.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "phaser": "3.90.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@agent-native/core": {
      "better-auth": "1.7.15",
      "@better-auth/core": "1.7.15",
      "@modelcontextprotocol/client": "2.4.0",
      "@modelcontextprotocol/server": "2.4.0",
      "@anthropic-ai/sdk": "0.91.1",
      "minimatch": "11.0.3"
    },
    "@vercel/cli-config": "0.3.6"
  },
  "engines": {
    "node": "24.x"
  }
}
